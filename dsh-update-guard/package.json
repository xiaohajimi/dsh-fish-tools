{
  "name": "dsh-update-guard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Locks the running DSH version, writes an alert and injects a reminder when the version changes.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
